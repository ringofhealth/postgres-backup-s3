# Copy to .env. Put secret values in the files referenced below; never commit
# those files. All *_FILE variables also work with Docker/Kubernetes secrets.
POSTGRES_VERSION=18
POSTGRES_DATABASE=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

S3_REGION=us-east-1
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=postgres-backups
S3_PREFIX=postgres
S3_HEAD_MAX_ATTEMPTS=8
S3_HEAD_RETRY_BASE_SECONDS=2
S3_ACCESS_KEY_ID_FILE=./secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=./secrets/s3_secret_access_key

# Physical pgBackRest target. These are ignored by the default logical image.
PGBACKREST_CONFIG=/dev/null
PGBACKREST_STANZA=app
PGBACKREST_REPO1_PATH=/pgbackrest
BACKUP_FULL_SCHEDULE=17 3 * * 0
BACKUP_DIFF_SCHEDULE=17 3 * * 1-6
BACKUP_INCR_SCHEDULE=47 0,6,12,18 * * *
BACKUP_CHECK_SCHEDULE=37 2 * * *
INIT_ON_STARTUP=yes

PASSPHRASE_FILE=./secrets/backup_passphrase
SCHEDULE=17 3 * * *
RUN_ON_STARTUP=no
BACKUP_MODE=stream
BACKUP_VERIFY_MODE=checksum
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MINIMUM=3
PGDUMP_EXTRA_OPTS=--no-owner --no-privileges
